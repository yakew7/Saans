# Copy to .env.local and fill in. Never commit real values. Never prefix secrets with NEXT_PUBLIC_.

# OpenAQ v3 (measured raw concentrations + history). Free key: https://explore.openaq.org/register
OPENAQ_API_KEY=

# WAQI (station AQI, map bounds, forecast). Free token: https://aqicn.org/data-platform/token
WAQI_API_TOKEN=

# LLM routing: auto | gemini | groq | none   (auto = Gemini first, fail over to Groq)
LLM_PROVIDER=auto

# Gemini (free tier). Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (free tier). Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Global daily cap on AI + transcription requests (protects free quotas)
AI_DAILY_CAP=500

# CARTO basemap key (optional). FREE, email-only: https://carto.com/basemaps/apikey
# Public by design (it appears in tile URLs in the browser), so it is NOT a secret.
# Without it the map falls back to OpenStreetMap tiles.
NEXT_PUBLIC_CARTO_KEY=

# Public site URL (not a secret). Used for Open Graph and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
